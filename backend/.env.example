# Copy to .env and adjust
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reach
SECRET_KEY=change-me-to-a-long-random-string
# Short-lived: tokens are stored in localStorage with no server-side revocation,
# so a stolen token stays valid until it expires.
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Publicly reachable base URL for this API. Uploaded signature/logo/badge
# images are served from here and linked directly in emails sent via
# Microsoft Graph -- set this to the real public hostname in any deployed
# environment (recipients' mail clients fetch images from this URL, not from
# your local machine).
PUBLIC_BASE_URL=http://localhost:8000

# Seeds a default admin@reach.io / Admin@123 account on startup. Local dev/demo
# only -- leave unset (or false) in production, and rotate the password
# immediately if you do turn this on.
SEED_DEFAULT_ADMIN=false

# Office 365 / Microsoft Graph email (Azure AD app registration with the
# APPLICATION permission Mail.Send, admin-consented). Leave blank to keep
# email sending simulated.
AZURE_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_FROM_EMAIL=

# Metamorph Systems bulk-SMS gateway (India DLT). Sender ID, template and message
# text must be pre-registered with the operator. Leave the credentials blank to
# keep SMS sending simulated.
SMS_USERNAME=
SMS_PASSWORD=
SMS_TEMPLATE_ID=
SMS_FROM=
SMS_API_URL=https://www.metamorphsystems.com/index.php/api/bulk-sms
SMS_SUCCESS_TOKEN=

# Queue-based sending: requires Redis and a separate `python -m app.worker`
# process running alongside the API (see README).
REDIS_URL=redis://localhost:6379/0
# Conservative defaults -- raise once real per-second caps are confirmed with
# Metamorph Systems / Microsoft Graph support.
EMAIL_RATE_PER_SECOND=5
SMS_RATE_PER_SECOND=5
SEND_MAX_RETRIES=3
